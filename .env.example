# Copy this file to .env.local and fill it in. .env.local is ignored by git.
# On Vercel, add the same names under Project Settings -> Environment Variables.
# Never commit real values, and never prefix any of these with NEXT_PUBLIC_.

# LiteLLM gateway address from the organisers. It must end in /v1.
LITELLM_BASE_URL=

# Your personal LiteLLM key from the organisers.
LITELLM_API_KEY=

# Main model: planning, ambiguity hunting, test design, review.
LITELLM_MODEL=claude-sonnet-5-5

# Fast, cheap model: extraction and ranking.
LITELLM_MODEL_FAST=claude-haiku

# Optional. A fine-grained GitHub token with read-only access to public
# repositories. It only raises GitHub's rate limits.
GITHUB_TOKEN=

# Optional. Set to "replay" to serve recorded sample runs only and make no
# model calls (use it if the budget runs low during judging).
DEMO_MODE=

# Optional, local development only. Set to 1 to use a canned stand-in model.
MOCK_LLM=

# Optional. Token prices used for the on-screen cost estimate, as
# "input,output" in USD per million tokens. Estimates only.
PRICE_MAIN=
PRICE_FAST=
