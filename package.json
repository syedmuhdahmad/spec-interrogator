{
  "name": "spec-interrogator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "npm run check:secrets && npm run lint && npm run typecheck && npm run test && npm run build",
    "record": "tsx scripts/record-replays.ts"
  },
  "dependencies": {
    "@cucumber/gherkin": "^43.0.0",
    "@cucumber/messages": "^35.0.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "next": "16.4.6",
    "openai": "^7.65.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=20.19"
  },
  "description": "Multi-agent QA analyst: turns a user story or GitHub issue into client questions, a validated Gherkin suite and a test plan ranked by risk."
}
